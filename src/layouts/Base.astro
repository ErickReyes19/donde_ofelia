---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { restaurant as r } from '../data/restaurant';
import ogSource from '../assets/local/gm-05.jpg';

interface Props { title: string; description: string }
const { title, description } = Astro.props;

const og = await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = Astro.site ? new URL(og.src, Astro.site).href : og.src;

// Datos estructurados (schema.org/Restaurant). Sin aggregateRating: Google no admite
// reseñas propias publicadas por el mismo negocio.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: r.fullName,
  slogan: r.slogan,
  servesCuisine: 'Mexicana',
  priceRange: 'L 80 – L 1,795',
  currenciesAccepted: 'HNL',
  telephone: r.phones.main.e164,
  menu: r.orderUrl,
  acceptsReservations: true,
  foundingDate: String(r.since),
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${r.address.street}, ${r.address.between}, ${r.address.landmark}`,
    addressLocality: 'San Pedro Sula',
    addressRegion: 'Cortés',
    postalCode: r.address.postalCode,
    addressCountry: r.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: r.geo.lat, longitude: r.geo.lng },
  hasMap: r.mapsUrl,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: r.hours.open,
      closes: r.hours.close,
    },
  ],
  sameAs: [r.social.instagram.url, r.social.facebook.url, r.social.tiktok.url],
};
---
<!doctype html>
<html lang="es-HN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0a09" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}

    <meta property="og:type" content="restaurant" />
    <meta property="og:locale" content="es_HN" />
    <meta property="og:site_name" content={r.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Oculta el hero antes del primer pintado para que su entrada no parpadee -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('intro');
    </script>
  </head>
  <body>
    <a href="#contenido" class="sr-only-focusable fixed left-4 top-4 z-[100] rounded-full bg-tiza px-5 py-3 font-semibold text-pizarra">
      Saltar al contenido
    </a>
    <slot />
    <script>
      import 'lenis/dist/lenis.css';
      import '../scripts/motion';
    </script>
  </body>
</html>
