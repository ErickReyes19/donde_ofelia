---
// Reserva por WhatsApp: el formulario arma el mensaje y abre wa.me. No hay backend.
import { restaurant as r } from '../data/restaurant';
import Moon from './illustrations/Moon.astro';
import Star from './illustrations/Star.astro';

// Horas de llegada: cada 30 minutos entre la apertura y una hora antes del cierre
const times: string[] = [];
for (let m = 12 * 60; m <= 21 * 60; m += 30) {
  const h = Math.floor(m / 60), mm = m % 60;
  times.push(`${h % 12 === 0 ? 12 : h % 12}:${String(mm).padStart(2, '0')} p.m.`);
}
---
<section id="reservar" class="section reserve" aria-labelledby="reserve-title">
  <div class="wrap reserve-grid">
    <div class="reserve-copy">
      <h2 id="reserve-title" class="display h2" data-reveal="words">Reserva tu mesa</h2>
      <p class="lead mt-6">
        Cuéntanos cuántos son y a qué hora llegan. Te confirmamos por WhatsApp.
      </p>
      <p class="muted mt-6 text-[1rem]">
        ¿Prefieres llamar? <a class="link text-tiza" href={`tel:${r.phones.main.e164}`}>+504 {r.phones.main.display}</a>
      </p>
      <div class="reserve-ill" aria-hidden="true" data-parallax-trigger>
        <Moon class="reserve-moon text-oro" data-speed="0.06" />
        <Star class="reserve-star reserve-star--a text-oro" data-speed="0.16" />
        <Star class="reserve-star reserve-star--b text-tiza" data-speed="0.24" />
      </div>
    </div>

    <form class="reserve-form" data-reserve-form data-wa={r.phones.main.wa} novalidate>
      <div class="field">
        <label for="rf-name">Nombre</label>
        <input id="rf-name" name="name" type="text" autocomplete="name" required aria-describedby="rf-name-err" />
        <p class="err" id="rf-name-err" data-err hidden>Escribe tu nombre.</p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="field">
          <label for="rf-people">Personas</label>
          <select id="rf-people" name="people" required>
            {Array.from({ length: 12 }, (_, i) => <option value={i + 1} selected={i === 1}>{i + 1}</option>)}
            <option value="más de 12">Más de 12</option>
          </select>
        </div>
        <div class="field">
          <label for="rf-time">Hora</label>
          <select id="rf-time" name="time" required>
            {times.map((t) => <option value={t} selected={t === '7:00 p.m.'}>{t}</option>)}
          </select>
        </div>
      </div>

      <div class="field">
        <label for="rf-date">Día</label>
        <input id="rf-date" name="date" type="date" required aria-describedby="rf-date-err" data-date />
        <p class="err" id="rf-date-err" data-err hidden>Elige el día de tu visita.</p>
      </div>

      <div class="field">
        <label for="rf-note">Algo que debamos saber <span class="muted">(opcional)</span></label>
        <textarea id="rf-note" name="note" rows="3" placeholder="Cumpleaños, silla para bebé, alergias…"></textarea>
      </div>

      <button class="btn btn-primary w-full" type="submit">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5.1 5.2-1.4a9.9 9.9 0 1 0 4.7-18.7Zm0 18.1a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3.1.8.8-3-.2-.3a8.2 8.2 0 1 1 7 3.8Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
        Enviar por WhatsApp
      </button>
      <p class="muted text-[0.9375rem]" data-reserve-note>
        Se abre WhatsApp con tu mensaje listo. La mesa queda reservada cuando te respondamos.
      </p>
    </form>
  </div>
</section>

<style>
  .reserve-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; row-gap: 48px; }
  .reserve-copy { grid-column: 1 / -1; position: relative; }
  .reserve-form { grid-column: 1 / -1; display: grid; gap: 20px; padding: clamp(24px, 4vw, 48px); background: var(--color-pizarra-2); border: 1px solid color-mix(in srgb, var(--color-tiza) 10%, transparent); }

  .reserve-ill { position: relative; height: 180px; margin-top: 40px; display: none; }
  .reserve-moon { position: absolute; width: 150px; left: 0; top: 0; }
  .reserve-star { position: absolute; }
  .reserve-star--a { width: 34px; left: 190px; top: 24px; }
  .reserve-star--b { width: 18px; left: 160px; top: 132px; opacity: .7; }

  .field { display: grid; gap: 8px; }
  .field label { font-size: 0.98rem; font-weight: 500; }
  .field input, .field select, .field textarea {
    width: 100%; min-height: 48px; padding: 10px 14px;
    background: var(--color-pizarra); color: var(--color-tiza);
    border: 1px solid color-mix(in srgb, var(--color-tiza) 22%, transparent); border-radius: 10px;
    font: inherit; font-size: 1rem;
    transition: border-color 160ms ease;
  }
  .field input:hover, .field select:hover, .field textarea:hover { border-color: color-mix(in srgb, var(--color-tiza) 45%, transparent); }
  .field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible { outline: 2px solid var(--color-oro); outline-offset: 1px; border-color: transparent; }
  .field [aria-invalid='true'] { border-color: var(--color-chile-claro); }
  .field textarea { resize: vertical; min-height: 96px; }
  .field ::placeholder { color: color-mix(in srgb, var(--color-tiza) 45%, transparent); }
  .err { color: var(--color-chile-claro); font-size: 0.9375rem; }
  input[type='date']::-webkit-calendar-picker-indicator { filter: invert(1) opacity(.7); }

  @media (min-width: 1024px) {
    .reserve-copy { grid-column: 1 / span 5; }
    .reserve-form { grid-column: 7 / span 6; }
    .reserve-ill { display: block; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-reserve-form]');
  if (form) {
    const date = form.querySelector<HTMLInputElement>('[data-date]')!;
    // Fecha mínima: hoy en Honduras
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Tegucigalpa' }).format(new Date());
    date.min = today;
    date.value = today;

    const showErr = (input: HTMLInputElement, show: boolean) => {
      input.setAttribute('aria-invalid', String(show));
      const err = document.getElementById(input.getAttribute('aria-describedby') ?? '');
      if (err) err.hidden = !show;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = form.elements.namedItem('name') as HTMLInputElement;
      const okName = name.value.trim().length > 1;
      const okDate = Boolean(date.value) && date.value >= today;
      showErr(name, !okName);
      showErr(date, !okDate);
      if (!okName) return name.focus();
      if (!okDate) return date.focus();

      const data = new FormData(form);
      const [y, m, d] = String(data.get('date')).split('-').map(Number);
      const day = new Intl.DateTimeFormat('es-HN', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }).format(Date.UTC(y, m - 1, d));
      const people = String(data.get('people'));
      const lines = [
        `Hola, quiero reservar una mesa en Donde Ofelia Los Andes.`,
        `Nombre: ${String(data.get('name')).trim()}`,
        `Personas: ${people}`,
        `Día: ${day}`,
        `Hora: ${data.get('time')}`,
      ];
      const note = String(data.get('note') ?? '').trim();
      if (note) lines.push(`Nota: ${note}`);
      const url = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`;
      window.open(url, '_blank', 'noopener');
    });

    form.querySelectorAll<HTMLInputElement>('input[required]').forEach((input) =>
      input.addEventListener('input', () => input.getAttribute('aria-invalid') === 'true' && showErr(input, false)),
    );
  }
</script>
